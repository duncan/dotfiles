export PATH="$HOME/.local/bin:$PATH"

# pnpm
if [[ "$OSTYPE" == darwin* ]] ; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

autoload -Uz compinit && compinit
