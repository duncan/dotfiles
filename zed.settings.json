{
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\b"
            }
          ]
        }
      }
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-opus-5-5",
      "enable_thinking": true,
      "effort": "medium"
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "claude-opus-5-5",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": []
  },
  "ui_font_size": 15,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "languages": {
    "Markdown": {
      "show_edit_predictions": false,
      "soft_wrap": "editor_width"
    }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.DS_Store",
    "**/node_modules",
    "**/.wrangler",
    "**/.zed",
    "**/.claude",
    "**/dist",
    "**/build",
    "**/.cache"
  ]
}
